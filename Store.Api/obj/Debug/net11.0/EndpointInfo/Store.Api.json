  "components": {
    "schemas": {
      "CategoryDTO": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductDTO": {
        "required": [
          "name",
          "price",
          "description",
          "stock"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 3,
            "type": [
              "null",
              "string"
            ]
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "description": {
            "maxLength": 200,
            "minLength": 5,
            "type": [
              "null",
              "string"
            ]
          },
          "stock": {
            "maximum": 9999,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "imageURL": {
            "type": [
              "null",
              "string"
            ]
          },
          "categoryName": {
