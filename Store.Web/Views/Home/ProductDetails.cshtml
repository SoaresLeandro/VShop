@model ProductViewModel

<form method="post">
    <input asp-for="@Model.Id" hidden=""/>
    <div class="container">
        <div class="row">

            <div class="card">
                <div class="card-header">
                    @Model.Name
                </div>
                <div class="card-body">
                    <h4 class="card-title">@Model.Description</h4>
                    Category: <p class="card-text">@Model.CategoryName</p>
                    <span>@Model.Price.ToString("C")</span>
                </div>
                <div class="card-footer">
                    <div class="row">
                        <div class="col-5 col-md-5 mb-5">
                            <a asp-action="Index" class="btn btn-outline-info">Back to List</a>
                        </div>
                        <div class="col-5 col-md-5">
                            <button type="submit" class="btn btn-outline-success">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>